# ─── Sito Davide Luongo — Variabili d'Ambiente ────────────────────────────────
# COPIA questo file in .env e compila i valori
# NON committare mai .env nel repository

# ── Server ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Sessioni admin ─────────────────────────────────────────────────────────────
SESSION_LIFETIME_HOURS=8
CSRF_TOKEN_LENGTH=32

# ── Database ────────────────────────────────────────────────────────────────────
# Percorso relativo alla root del progetto L:\Sito_Dave
DATABASE_URL=sqlite:///L:/Sito_Dave/private/database/sito_dave.db

# ── SMTP Aruba ─────────────────────────────────────────────────────────────────
ARUBA_SMTP_USER=info@davideluongo.it
ARUBA_SMTP_PASS=
ARUBA_SMTP_HOST=smtps.aruba.it
ARUBA_SMTP_PORT=465

# ── Sicurezza ──────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=10
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15

# ── Upload / Immagini ──────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=10485760        # 10 MB limite upload grezzo
IMAGE_MAX_DIMENSION=2048
IMAGE_MAX_OUTPUT_BYTES=5242880   # 5 MB output
IMAGE_QUALITY_WEBP=85
IMAGE_QUALITY_JPEG=88
IMAGE_QUALITY_MIN=55

# ── Privacy / Conservazione ────────────────────────────────────────────────────
REPORT_RETENTION_DAYS=365
LOG_RETENTION_DAYS=90

# ── PayPal [ISOLATO — NON MODIFICARE senza autorizzazione] ─────────────────────
PAYPAL_ENV=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# URL pubblica usata nei link delle email e nelle disiscrizioni
SITE_PUBLIC_URL=https://www.davideluongo.it
